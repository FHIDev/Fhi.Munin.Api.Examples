# Kopier denne filen til .env og fyll inn verdiene du har fått fra FHI.
# .env skal aldri legges i git (den står i .gitignore).

# Entra ID (Microsoft) for FHI: tenant-id, og klient-id og -hemmelighet fra
# app-registreringen din.
MUNIN_TENANT_ID=<tenant-id>
MUNIN_CLIENT_ID=<klient-id-for-din-app-registrering>
MUNIN_CLIENT_SECRET=<klienthemmelighet>

# Scope for Munins API i testmiljøet: api://<munin-app-id>/.default
MUNIN_SCOPE=api://<munin-app-id>/.default

# Adressene til API-ene i testmiljøet. La dem stå som de er.
MUNIN_INGEST_URL=https://ingest.munin.skytest.fhi.no
MUNIN_EXPORT_URL=https://export.munin.skytest.fhi.no
